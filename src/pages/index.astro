---
import BaseLayout from '../layouts/BaseLayout.astro';
import BracketLink from '../components/BracketLink.astro';
import Bullet from '../components/Bullet.astro';
import Project from '../components/Project.astro';

const title = 'Alejandro Caserez — caserez.dev';
---

<BaseLayout title={title}>
  <div class="page">
    <div class="doc">
      <div class="chrome">
        <div class="chrome-left">
          <span class="logo"><span class="bracket">[</span>ac<span class="bracket">]</span></span>
          <span>index.md</span>
        </div>
        <span>caserez.dev</span>
      </div>

      <header>
        <h1><span class="marker">#</span><span>Alejandro Caserez</span></h1>
        <nav>
          <BracketLink href="https://x.com/alecaserez">X</BracketLink>
          <BracketLink href="https://github.com/alecaserez">GitHub</BracketLink>
          <BracketLink href="https://www.linkedin.com/in/caserezalejandro/">LinkedIn</BracketLink>
          <BracketLink href="mailto:hola@caserez.dev">Mail</BracketLink>
        </nav>
      </header>

      <section>
        <h2><span class="marker">##</span><span>Qué hice</span></h2>

        <Project id="zonacitas" title="Zonacitas">
          <p class="body">
            App de citas argentina, con más de 4 millones de usuarios registrados. Android e iOS
            nativos, backend propio y cobros directos contra las tres plataformas.
          </p>
          <ul class="points">
            <Bullet>
              Suscripciones integradas directo contra Google Play, App Store y Mercadopago, sin
              intermediarios.
            </Bullet>
            <Bullet>App de iOS escrita desde cero en SwiftUI.</Bullet>
            <Bullet>Sistema de matching implementado.</Bullet>
            <Bullet>
              Identidad unificada entre web, Android e iOS.
            </Bullet>
          </ul>
        </Project>

        <Project id="custoo" title="Custoo" spaced>
          <p class="body">
            Plataforma de analytics de audiencia para streaming. Medía YouTube, Twitch y Kick, y
            publicaba esos datos dentro de los medios que la usaban.
          </p>
          <p class="quote">Adquirida por Thebrains y la UTN. Hoy opera como Cognitia.</p>
          <ul class="points">
            <Bullet>
              Medición de audiencia en tiempo real y datos totales cada 1 hora.
            </Bullet>
            <Bullet>
              Embeds con autenticación por hash y permisos de dominio por token, para que cada medio
              publicara los datos dentro de sus propias notas sin exponer la plataforma.
            </Bullet>
            <Bullet>
              Ingesta contra tres APIs con límites, formatos y ritmos distintos, normalizada a un
              mismo modelo.
            </Bullet>
          </ul>
        </Project>

        <Project id="get" title="GET el juego interactivo" spaced>
          <p class="body">
            GET es el unipersonal interactivo de Pedro Rosemblat, estrenado en el Teatro Astros. El
            público juega desde el celular durante la función y al final se reparte un premio.
          </p>
          <p class="quote">
            Tres funciones de estreno. De 1.521 espectadores se anotaron 1.448 —el 95% de la sala— y
            1.274 jugaron las cuatro rondas completas. 5.481 respuestas en 12 rondas.
          </p>
          <ul class="points">
            <Bullet>Cero mensajes fallidos y cero bajas en las tres funciones.</Bullet>
            <Bullet>
              Costo de mensajería cero: todo resuelto dentro de la ventana de 24 horas por opt-in.
            </Bullet>
          </ul>
        </Project>

        <p class="more">Entre otros proyectos.</p>
      </section>
    </div>
  </div>
</BaseLayout>

<style>
  .page {
    display: flex;
    justify-content: center;
    min-height: 100vh;
    padding: 64px 24px 140px;
    background: var(--bg);
    color: var(--fg);
    font-family: var(--font-mono);
    font-size: 14.5px;
    line-height: 1.8;
    letter-spacing: -0.005em;
    text-wrap: pretty;
  }

  .doc {
    display: flex;
    flex-direction: column;
    gap: 40px;
    width: 100%;
    max-width: 740px;
  }

  /* barra superior: [ac] index.md ............ caserez.dev */
  .chrome {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    padding-bottom: 12px;
    border-bottom: 1px solid var(--rule);
    font-size: 12.5px;
    color: var(--muted-chrome);
  }

  .chrome-left {
    display: flex;
    align-items: baseline;
    gap: 10px;
  }

  .logo {
    font-size: 17px;
    font-weight: 500;
    letter-spacing: -0.03em;
    color: var(--fg-h3);
  }

  .logo .bracket {
    color: var(--muted-key);
  }

  /* front matter YAML opcional */
  .frontmatter {
    display: flex;
    flex-direction: column;
    font-size: 13px;
    line-height: 1.9;
    color: var(--fg-meta);
  }

  .fence {
    color: var(--rule-hr);
  }

  .fields {
    display: grid;
    grid-template-columns: 88px 1fr;
    column-gap: 8px;
  }

  .key {
    color: var(--muted-key);
  }

  .value {
    color: var(--fg-strong);
  }

  header {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  h1 {
    display: flex;
    gap: 12px;
    margin: 0;
    font-size: 27px;
    font-weight: 500;
    letter-spacing: -0.035em;
    line-height: 1.25;
    color: var(--fg-h1);
  }

  h2 {
    display: flex;
    gap: 12px;
    margin: 0;
    font-size: 19px;
    font-weight: 500;
    letter-spacing: -0.025em;
    color: var(--fg-h2);
  }

  .marker {
    font-weight: 400;
    color: var(--syntax);
  }

  .lede {
    margin: 0;
    padding-left: 24px;
    max-width: 52ch;
    font-size: 16.5px;
    line-height: 1.7;
    color: var(--fg-lede);
  }

  nav {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 14px;
    padding-left: 24px;
    font-size: 13.5px;
    color: var(--bracket);
  }

  section {
    display: flex;
    flex-direction: column;
    gap: 36px;
    padding-top: 32px;
    border-top: 1px solid var(--rule);
  }

  .toc {
    display: flex;
    flex-direction: column;
    gap: 4px;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 13.5px;
    color: var(--muted);
  }

  .body {
    margin: 0;
    max-width: 70ch;
    color: var(--fg-body);
  }

  .quote {
    margin: 0;
    padding: 2px 0 2px 16px;
    max-width: 70ch;
    border-left: 2px solid var(--rule-quote);
    color: var(--fg-body);
  }

  .points {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin: 0;
    padding: 0;
    max-width: 74ch;
    list-style: none;
    color: var(--fg-list);
  }

  .points-note {
    margin: 0;
    max-width: 74ch;
    color: var(--fg-list);
  }

  .more {
    margin: 0;
    padding-top: 28px;
    font-size: 13px;
    color: var(--muted-chrome);
  }

</style>
