---
/* Sección de proyecto: encabezado `### Nombre` + contenido.
   Con `href` el título linkea al proyecto. */
interface Props {
  id: string;
  title: string;
  href?: string;
  spaced?: boolean;
}

const { id, title, href, spaced = false } = Astro.props;
---

<article id={id} class:list={['project', { spaced }]}>
  <h3>
    <span class="marker">###</span>
    {href ? <a href={href}>{title}</a> : <span>{title}</span>}
  </h3>
  <slot />
</article>

<style>
  .project {
    display: flex;
    flex-direction: column;
    gap: 14px;
    scroll-margin-top: 32px;
  }

  .spaced {
    padding-top: 28px;
  }

  h3 {
    margin: 0;
    display: flex;
    gap: 12px;
    font-size: 16.5px;
    font-weight: 500;
    letter-spacing: -0.02em;
    color: var(--fg-h3);
  }

  /* el título linkeado mantiene el tono del h3, no el de un link suelto */
  h3 a {
    color: inherit;
    border-bottom-color: var(--rule-hr);
  }

  h3 a:hover {
    color: var(--fg-hi);
    border-bottom-color: var(--fg-hi);
  }

  .marker {
    font-weight: 400;
    color: var(--syntax);
  }
</style>
